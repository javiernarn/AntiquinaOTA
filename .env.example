# Google OAuth Client ID (Google Cloud Console → APIs & Services → Credentials
# → OAuth client ID → Web application). Add your app's dev/prod URLs to
# "Authorized JavaScript origins" (e.g. http://localhost:5173).
VITE_GOOGLE_CLIENT_ID=

# --- Push notifications (Firebase) -----------------------------------------
# Optional. Leave all of these blank and the app works exactly as before,
# just without real push notifications. Fill them in to turn on "shift
# starting soon" / lunch / clock-out reminders that reach the phone even
# when the app is closed. See SETUP.md for exactly where each value comes
# from in the Firebase console.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_VAPID_KEY=

# --- Push notifications: server-side scheduler (api/send-reminders.js) ----
# Required only for the /api/send-reminders endpoint that an external free
# cron service calls every few minutes. Not prefixed with VITE_ — these
# stay server-side only, never sent to the browser.
#
# CRON_SECRET: any random string you make up yourself. The cron service
# must send it back as either header "x-cron-secret" or query "?secret=".
CRON_SECRET=

# FIREBASE_SERVICE_ACCOUNT_B64: Firebase Console → Project settings →
# Service accounts → Generate new private key (downloads a .json file).
# Base64-encode the whole file's contents into one line and paste it here.
#   macOS/Linux: base64 -i service-account.json | tr -d '\n'
#   Windows (PowerShell): [Convert]::ToBase64String([IO.File]::ReadAllBytes("service-account.json"))
FIREBASE_SERVICE_ACCOUNT_B64=
